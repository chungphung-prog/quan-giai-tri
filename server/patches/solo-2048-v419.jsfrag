  register('2048', stage=>{
    let b=Array(16).fill(0),score=0,moves=0,over=false,lastSpawn=-1,lastMerged=new Set();
    const add=()=>{const e=b.map((v,i)=>v?null:i).filter(x=>x!==null);if(!e.length)return;lastSpawn=e[Math.floor(rand()*e.length)];b[lastSpawn]=rand()<.9?2:4};
    add();add();
    stage.innerHTML=`<div class="game2048-pro"><div class="solo-game-toolbar"><div><div class="eyebrow">NUMBER MERGE</div><h2>2048 Neon Grid</h2></div><div class="solo-stat-row"><div class="solo-stat"><span>Điểm</span><b id="score">0</b></div><div class="solo-stat"><span>Ô lớn nhất</span><b id="maxTile">4</b></div><div class="solo-stat"><span>Lượt</span><b id="moveCount">0</b></div></div></div><div class="g2048-shell"><div id="g" class="g2048 g2048-v2"></div></div><div class="pad2048" aria-label="Điều khiển 2048"><span></span><button data-dir="U">↑</button><span></span><button data-dir="L">←</button><button data-dir="D">↓</button><button data-dir="R">→</button></div><div id="msg2048" class="message">Ghép hai ô cùng số • WASD / phím mũi tên / nút điều hướng</div></div>`;
    const g=$('#g'),msg=$('#msg2048');
    function merge(line){let a=line.filter(Boolean),merged=[];for(let i=0;i<a.length-1;i++){if(a[i]===a[i+1]){a[i]*=2;score+=a[i];merged.push(i);a.splice(i+1,1)}}while(a.length<4)a.push(0);return {line:a,merged}}
    function project(dir,write=true){const src=b.slice();let nb=Array(16).fill(0),didMerge=new Set();for(let k=0;k<4;k++){let line=[],indices=[];for(let j=0;j<4;j++){let r,c;if(dir==='L'){r=k;c=j}else if(dir==='R'){r=k;c=3-j}else if(dir==='U'){r=j;c=k}else{r=3-j;c=k}line.push(src[r*4+c]);indices.push(r*4+c)}const before=line.join(','),m=merge(line);for(let j=0;j<4;j++){let r,c;if(dir==='L'){r=k;c=j}else if(dir==='R'){r=k;c=3-j}else if(dir==='U'){r=j;c=k}else{r=3-j;c=k}nb[r*4+c]=m.line[j];if(m.merged.includes(j))didMerge.add(r*4+c)}if(!write)score-=0;void before}return {nb,didMerge}}
    function canMove(){if(b.includes(0))return true;for(let r=0;r<4;r++)for(let c=0;c<4;c++){const v=b[r*4+c];if(c<3&&b[r*4+c+1]===v)return true;if(r<3&&b[(r+1)*4+c]===v)return true}return false}
    function move(dir){if(over)return;const old=b.join(','),oldScore=score;const out=project(dir,true);b=out.nb;if(b.join(',')===old){score=oldScore;return}lastMerged=out.didMerge;moves++;add();draw();beep(lastMerged.size?680:430,.02);if(!canMove()){over=true;msg.className='message game-over-msg';msg.textContent=`Hết nước đi • ${score.toLocaleString('vi-VN')} điểm`;award('2048',score,'Kết thúc 2048');}}
    function tileClass(v){if(!v)return'empty';const p=Math.min(13,Math.round(Math.log2(v)));return`v${p}`}
    function draw(){g.innerHTML=b.map((v,i)=>`<div class="tile2048 ${tileClass(v)} ${i===lastSpawn?'spawn':''} ${lastMerged.has(i)?'merged':''}"><span>${v||''}</span></div>`).join('');$('#score').textContent=score.toLocaleString('vi-VN');$('#maxTile').textContent=Math.max(...b).toLocaleString('vi-VN');$('#moveCount').textContent=moves;lastSpawn=-1;lastMerged=new Set()}
    function key(e){const m={ArrowLeft:'L',a:'L',A:'L',ArrowRight:'R',d:'R',D:'R',ArrowUp:'U',w:'U',W:'U',ArrowDown:'D',s:'D',S:'D'};if(m[e.key]){e.preventDefault();move(m[e.key])}}
    let sx=0,sy=0;g.ontouchstart=e=>{const t=e.touches[0];sx=t.clientX;sy=t.clientY};g.ontouchend=e=>{const t=e.changedTouches[0],dx=t.clientX-sx,dy=t.clientY-sy;if(Math.max(Math.abs(dx),Math.abs(dy))<20)return;move(Math.abs(dx)>Math.abs(dy)?(dx>0?'R':'L'):(dy>0?'D':'U'))};
    window.addEventListener('keydown',key);$$('[data-dir]',stage).forEach(btn=>btn.onclick=()=>move(btn.dataset.dir));cleanup=()=>window.removeEventListener('keydown',key);draw();
  });
