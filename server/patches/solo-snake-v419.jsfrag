  register('snake', stage=>{
    stage.innerHTML=`<div class="snake-pro"><div class="solo-game-toolbar"><div><div class="eyebrow">NEON ARCADE</div><h2>Snake</h2></div><div class="solo-stat-row"><div class="solo-stat"><span>Táo</span><b id="score">0</b></div><div class="solo-stat"><span>Độ dài</span><b id="snakeLen">3</b></div></div></div><div class="canvas-wrap neon-canvas"><canvas id="cv" width="500" height="500"></canvas></div><div id="snakeMsg" class="message">WASD / phím mũi tên • ăn táo và đừng cắn chính mình</div></div>`;
    const cv=$('#cv'),ctx=cv.getContext('2d'),N=20,S=cv.width/N,msg=$('#snakeMsg');let snake=[{x:10,y:10},{x:9,y:10},{x:8,y:10}],dir={x:1,y:0},next={x:1,y:0},food={x:15,y:10},score=0,dead=false,timer=null;
    function newFood(){do{food={x:Math.floor(rand()*N),y:Math.floor(rand()*N)}}while(snake.some(s=>s.x===food.x&&s.y===food.y))}
    function rounded(x,y,w,h,r){ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
    function drawGrid(){ctx.strokeStyle='rgba(125,211,252,.055)';ctx.lineWidth=1;for(let i=1;i<N;i++){ctx.beginPath();ctx.moveTo(i*S,0);ctx.lineTo(i*S,500);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*S);ctx.lineTo(500,i*S);ctx.stroke()}}
    function drawHead(h){const x=h.x*S+2,y=h.y*S+2,w=S-4;ctx.save();ctx.shadowColor='#4ade80';ctx.shadowBlur=16;ctx.fillStyle='#57f287';rounded(x,y,w,w,8);ctx.shadowBlur=0;ctx.fillStyle='#062a16';let eyes;if(dir.x!==0)eyes=dir.x>0?[[x+w-6,y+6],[x+w-6,y+w-9]]:[[x+6,y+6],[x+6,y+w-9]];else eyes=dir.y>0?[[x+6,y+w-6],[x+w-9,y+w-6]]:[[x+6,y+6],[x+w-9,y+6]];for(const [ex,ey] of eyes){ctx.beginPath();ctx.arc(ex,ey,2.2,0,Math.PI*2);ctx.fill()}ctx.strokeStyle='#fb7185';ctx.lineWidth=2;ctx.beginPath();if(dir.x>0){ctx.moveTo(x+w,y+w/2);ctx.lineTo(x+w+6,y+w/2)}else if(dir.x<0){ctx.moveTo(x,y+w/2);ctx.lineTo(x-6,y+w/2)}else if(dir.y>0){ctx.moveTo(x+w/2,y+w);ctx.lineTo(x+w/2,y+w+6)}else{ctx.moveTo(x+w/2,y);ctx.lineTo(x+w/2,y-6)}ctx.stroke();ctx.restore()}
    function draw(){const grad=ctx.createLinearGradient(0,0,500,500);grad.addColorStop(0,'#07131d');grad.addColorStop(.55,'#0a1a24');grad.addColorStop(1,'#071018');ctx.fillStyle=grad;ctx.fillRect(0,0,500,500);drawGrid();ctx.save();ctx.shadowColor='#ef4444';ctx.shadowBlur=18;ctx.font='22px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('🍎',food.x*S+S/2,food.y*S+S/2+1);ctx.restore();snake.slice(1).forEach((p,i)=>{const a=1-i/Math.max(8,snake.length*1.3);ctx.fillStyle=`rgba(34,197,94,${Math.max(.45,a)})`;ctx.shadowColor='rgba(34,197,94,.35)';ctx.shadowBlur=8;rounded(p.x*S+3,p.y*S+3,S-6,S-6,7)});ctx.shadowBlur=0;drawHead(snake[0]);if(dead){ctx.fillStyle='rgba(2,6,23,.72)';ctx.fillRect(0,0,500,500);ctx.fillStyle='white';ctx.font='900 38px system-ui';ctx.textAlign='center';ctx.fillText('GAME OVER',250,235);ctx.font='600 18px system-ui';ctx.fillStyle='#a7f3d0';ctx.fillText(`${score} táo • dài ${snake.length}`,250,270)}}
    function tick(){if(dead)return;dir=next;const h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(h.x<0||h.y<0||h.x>=N||h.y>=N||snake.some(s=>s.x===h.x&&s.y===h.y)){dead=true;msg.textContent=`💥 Kết thúc • ${score} táo`;award('snake',score*20,`Snake ${score}`);draw();return}snake.unshift(h);if(h.x===food.x&&h.y===food.y){score++;$('#score').textContent=score;$('#snakeLen').textContent=snake.length;newFood();beep(680,.04);msg.textContent='🍎 Ngon! Rắn dài thêm rồi.'}else snake.pop();draw();timer=setTimeout(tick,Math.max(42,118/speedFactor()))}
    function key(e){const m={ArrowUp:{x:0,y:-1},w:{x:0,y:-1},W:{x:0,y:-1},ArrowDown:{x:0,y:1},s:{x:0,y:1},S:{x:0,y:1},ArrowLeft:{x:-1,y:0},a:{x:-1,y:0},A:{x:-1,y:0},ArrowRight:{x:1,y:0},d:{x:1,y:0},D:{x:1,y:0}};const n=m[e.key];if(n&&!(n.x===-dir.x&&n.y===-dir.y)){e.preventDefault();next=n}}
    window.addEventListener('keydown',key);timer=setTimeout(tick,250);cleanup=()=>{clearTimeout(timer);window.removeEventListener('keydown',key)};draw();
  });
