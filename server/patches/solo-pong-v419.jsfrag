  register('pong', stage=>{
    stage.innerHTML=`<div class="pong-pro"><div class="solo-game-toolbar"><div><div class="eyebrow">SMOOTH ARENA</div><h2>Pong</h2></div><div class="pong-score"><span>BẠN</span><b id="sc">0 : 0</b><span>AI</span></div></div><div class="canvas-wrap pong-canvas"><canvas id="cv" width="720" height="440"></canvas></div><div id="pongMsg" class="message">Di chuột / kéo ngón tay theo chiều dọc • chạm 7 điểm để thắng</div></div>`;
    const cv=$('#cv'),ctx=cv.getContext('2d'),msg=$('#pongMsg');let py=175,targetY=175,ay=175,bx=360,by=220,vx=290,vy=185,ps=0,as=0,over=false,raf=0,last=performance.now(),trail=[];
    function reset(d=1){bx=360;by=220;vx=300*d;vy=(rand()*220-110)||120;trail=[]}
    function pointer(y){const r=cv.getBoundingClientRect();targetY=(y-r.top)*cv.height/r.height-45;targetY=Math.max(0,Math.min(cv.height-90,targetY))}
    cv.onmousemove=e=>pointer(e.clientY);cv.ontouchmove=e=>{e.preventDefault();pointer(e.touches[0].clientY)};
    function collidePaddle(x,y,w,h,dir){if(dir<0&&vx<0&&bx-8<x+w&&bx+8>x&&by>y&&by<y+h){const rel=(by-(y+h/2))/(h/2);vx=Math.abs(vx)*1.025;vy+=rel*70;beep(560,.018);return true}if(dir>0&&vx>0&&bx+8>x&&bx-8<x+w&&by>y&&by<y+h){const rel=(by-(y+h/2))/(h/2);vx=-Math.abs(vx)*1.025;vy+=rel*70;beep(430,.018);return true}return false}
    function update(dt){if(over)return;const sf=Math.min(1.55,speedFactor());py+=(targetY-py)*Math.min(1,dt*13);const aiTarget=by-45;ay+=(aiTarget-ay)*Math.min(1,dt*(3.8+aiFactor()*.75));ay=Math.max(0,Math.min(350,ay));trail.unshift({x:bx,y:by});trail=trail.slice(0,9);bx+=vx*dt*sf;by+=vy*dt*sf;if(by<10){by=10;vy=Math.abs(vy)}if(by>430){by=430;vy=-Math.abs(vy)}collidePaddle(24,py,14,90,-1);collidePaddle(682,ay,14,90,1);if(bx<-20){as++;$('#sc').textContent=`${ps} : ${as}`;msg.textContent='AI ghi điểm • tập trung cú tiếp theo';reset(1)}if(bx>740){ps++;$('#sc').textContent=`${ps} : ${as}`;msg.textContent='🔥 Ghi điểm!';reset(-1)}if(ps>=7||as>=7){over=true;msg.textContent=ps>=7?'🏆 Bạn thắng Pong!':'AI thắng ván này.';award('pong',ps>=7?220:40,ps>=7?'Thắng Pong':'Thua Pong')}}
    function roundRect(x,y,w,h,r,fill){ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fillStyle=fill;ctx.fill()}
    function draw(){const bg=ctx.createLinearGradient(0,0,720,440);bg.addColorStop(0,'#061321');bg.addColorStop(.5,'#091827');bg.addColorStop(1,'#07111f');ctx.fillStyle=bg;ctx.fillRect(0,0,720,440);ctx.strokeStyle='rgba(125,211,252,.08)';ctx.lineWidth=1;for(let y=40;y<440;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(720,y);ctx.stroke()}ctx.setLineDash([10,13]);ctx.strokeStyle='rgba(255,255,255,.18)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(360,0);ctx.lineTo(360,440);ctx.stroke();ctx.setLineDash([]);trail.forEach((p,i)=>{ctx.fillStyle=`rgba(96,165,250,${.18*(1-i/trail.length)})`;ctx.beginPath();ctx.arc(p.x,p.y,8-i*.45,0,Math.PI*2);ctx.fill()});ctx.shadowBlur=18;ctx.shadowColor='#60a5fa';roundRect(24,py,14,90,7,'#7dd3fc');ctx.shadowColor='#c084fc';roundRect(682,ay,14,90,7,'#c084fc');ctx.shadowColor='#f8fafc';ctx.shadowBlur=20;ctx.fillStyle='white';ctx.beginPath();ctx.arc(bx,by,8,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;if(over){ctx.fillStyle='rgba(2,6,23,.72)';ctx.fillRect(0,0,720,440);ctx.fillStyle='white';ctx.font='900 34px system-ui';ctx.textAlign='center';ctx.fillText(ps>=7?'VICTORY':'MATCH OVER',360,215)}}
    function frame(now){const dt=Math.min(.032,(now-last)/1000||.016);last=now;update(dt);draw();if(!over)raf=requestAnimationFrame(frame)}
    raf=requestAnimationFrame(frame);cleanup=()=>{cancelAnimationFrame(raf);cv.onmousemove=null;cv.ontouchmove=null};draw();
  });
