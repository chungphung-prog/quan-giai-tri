  register('flappy', stage=>{
    stage.innerHTML=`<div class="flappy-pro"><div class="solo-game-toolbar"><div><div class="eyebrow">OFFICE SKYLINE</div><h2>Flappy Office</h2></div><div class="solo-stat-row"><div class="solo-stat"><span>Điểm</span><b id="sc">0</b></div><div class="solo-stat"><span>Best run</span><b id="flappyBest">0</b></div></div></div><div class="canvas-wrap flappy-canvas"><canvas id="cv" width="720" height="440"></canvas></div><div id="flappyMsg" class="message">Space / click / chạm để vỗ cánh • bay qua khoảng trống giữa các tòa nhà</div></div>`;
    const cv=$('#cv'),ctx=cv.getContext('2d'),msg=$('#flappyMsg');let y=220,vy=0,score=0,over=false,pipes=[{x:780,gap:165,gy:220,passed:false}],raf=0,last=performance.now(),cloudT=0,wing=0;
    $('#flappyBest').textContent=state.highs.flappy||0;
    function flap(){if(over)return;vy=-300;wing=1;beep(660,.018)}
    function key(e){if(e.code==='Space'){e.preventDefault();flap()}}
    cv.onclick=flap;window.addEventListener('keydown',key);
    function update(dt){if(over)return;const sf=Math.min(1.55,speedFactor());cloudT+=dt*26*sf;wing=Math.max(0,wing-dt*4);vy+=820*dt*Math.min(1.28,sf);y+=vy*dt;pipes.forEach(p=>p.x-=180*dt*sf);if(pipes[pipes.length-1].x<420)pipes.push({x:780,gap:158,gy:115+rand()*210,passed:false});if(pipes[0].x<-100)pipes.shift();for(const p of pipes){if(!p.passed&&p.x<128){p.passed=true;score++;$('#sc').textContent=score;msg.textContent=score%5===0?'🔥 Nice streak!':'✅ Qua một tòa nhà!';beep(760,.02)}const hitX=128+17>p.x&&128-17<p.x+70,hitY=y-15<p.gy-p.gap/2||y+15>p.gy+p.gap/2;if(hitX&&hitY)over=true}if(y<12||y>428)over=true;if(over){msg.textContent=`💥 Hết chuyến bay • ${score} điểm`;award('flappy',score*35,`Flappy ${score}`)}}
    function buildingSegment(x,y0,w,h,side,capAtBottom=false){if(h<=0)return;const grad=ctx.createLinearGradient(x,y0,x+w,y0+h);grad.addColorStop(0,side?'#14b8a6':'#2563eb');grad.addColorStop(1,side?'#0f766e':'#1e3a8a');ctx.fillStyle=grad;ctx.fillRect(x,y0,w,h);ctx.save();ctx.beginPath();ctx.rect(x,y0,w,h);ctx.clip();ctx.fillStyle='rgba(255,255,255,.18)';for(let yy=y0+16;yy<y0+h;yy+=28)for(let xx=x+12;xx<x+w-8;xx+=22)ctx.fillRect(xx,yy,9,12);ctx.restore();ctx.fillStyle='rgba(255,255,255,.34)';const capY=capAtBottom?y0+h-2:y0-10;ctx.fillRect(x-5,capY,w+10,12)}
    function bird(){ctx.save();ctx.translate(128,y);ctx.rotate(Math.max(-.45,Math.min(.65,vy/650)));ctx.shadowColor='#facc15';ctx.shadowBlur=16;ctx.fillStyle='#fde047';ctx.beginPath();ctx.ellipse(0,0,18,14,0,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle='#f59e0b';ctx.beginPath();ctx.moveTo(15,-2);ctx.lineTo(30,2);ctx.lineTo(15,7);ctx.closePath();ctx.fill();ctx.fillStyle='white';ctx.beginPath();ctx.arc(7,-5,5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#111827';ctx.beginPath();ctx.arc(9,-5,2,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fb923c';ctx.save();ctx.rotate(wing>.2?-.7:.35);ctx.beginPath();ctx.ellipse(-7,5,13,6,0,0,Math.PI*2);ctx.fill();ctx.restore();ctx.restore()}
    function draw(){const sky=ctx.createLinearGradient(0,0,0,440);sky.addColorStop(0,'#0ea5e9');sky.addColorStop(.5,'#38bdf8');sky.addColorStop(1,'#bae6fd');ctx.fillStyle=sky;ctx.fillRect(0,0,720,440);ctx.fillStyle='rgba(255,255,255,.42)';for(let i=0;i<5;i++){const x=((i*190-cloudT*.35)%900)-100,yc=55+(i%3)*38;ctx.beginPath();ctx.arc(x,yc,22,0,Math.PI*2);ctx.arc(x+25,yc-7,28,0,Math.PI*2);ctx.arc(x+54,yc,20,0,Math.PI*2);ctx.fill()}ctx.fillStyle='rgba(30,64,175,.18)';for(let i=0;i<12;i++){const x=((i*76-cloudT)%850)-60,h=50+(i%4)*22;ctx.fillRect(x,440-h,48,h)}pipes.forEach((p,i)=>{const upper=Math.max(0,p.gy-p.gap/2),lowerY=Math.min(440,p.gy+p.gap/2);buildingSegment(p.x,0,70,upper,i%2===0,true);buildingSegment(p.x,lowerY,70,440-lowerY,i%2!==0,false)});bird();ctx.fillStyle='rgba(255,255,255,.78)';ctx.font='800 15px system-ui';ctx.textAlign='left';ctx.fillText('QGT CITY',18,28);if(over){ctx.fillStyle='rgba(2,6,23,.58)';ctx.fillRect(0,0,720,440);ctx.fillStyle='white';ctx.font='900 35px system-ui';ctx.textAlign='center';ctx.fillText('FLIGHT OVER',360,210);ctx.font='600 18px system-ui';ctx.fillStyle='#e0f2fe';ctx.fillText(`${score} tòa nhà đã vượt qua`,360,245)}}
    function frame(now){const dt=Math.min(.032,(now-last)/1000||.016);last=now;update(dt);draw();if(!over)raf=requestAnimationFrame(frame)}
    raf=requestAnimationFrame(frame);cleanup=()=>{cancelAnimationFrame(raf);window.removeEventListener('keydown',key)};draw();
  });
