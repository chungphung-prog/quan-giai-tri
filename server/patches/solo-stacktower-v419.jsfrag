  register('stacktower', stage=>{
    stage.innerHTML=`<div class="stacktower-pro"><div class="solo-game-toolbar"><div><div class="eyebrow">SKYLINE BUILDER</div><h2>Stack Tower</h2></div><div class="solo-stat-row"><div class="solo-stat"><span>Tầng</span><b id="sc">0</b></div><div class="solo-stat"><span>Perfect</span><b id="perfect">0</b></div></div></div><div class="canvas-wrap tower-canvas"><canvas id="cv" width="460" height="620"></canvas></div><div id="towerMsg" class="message">Click / Space để thả khối • đặt càng chuẩn càng giữ được chiều rộng</div></div>`;
    const cv=$('#cv'),ctx=cv.getContext('2d'),msg=$('#towerMsg');let blocks=[{x:100,y:560,w:260,h:30,hue:260}],cur={x:0,y:530,w:260,h:30,v:185,hue:190},score=0,perfect=0,over=false,raf=0,last=performance.now(),flash=0;
    function drop(){if(over)return;const base=blocks[blocks.length-1],left=Math.max(cur.x,base.x),right=Math.min(cur.x+cur.w,base.x+base.w);let w=right-left;if(w<=5){over=true;msg.textContent=`💥 Tháp đổ ở tầng ${score}`;award('stacktower',score*30+perfect*15,`Stack ${score} • Perfect ${perfect}`);beep(150,.12);return}const off=Math.abs(cur.x-base.x);if(off<=4){w=base.w;cur.x=base.x;perfect++;$('#perfect').textContent=perfect;msg.textContent='✨ PERFECT DROP!';flash=1;beep(820,.05)}else{msg.textContent=`Đẹp! Còn ${Math.round(w)}px bề rộng`;beep(600,.025)}blocks.push({x:Math.max(cur.x,base.x),y:cur.y,w,h:30,hue:(190+score*17)%360});score++;$('#sc').textContent=score;if(blocks.length>15)blocks.forEach(b=>b.y+=30);const dir=cur.v>0?1:-1;cur={x:dir>0?0:460-w,y:blocks[blocks.length-1].y-30,w,h:30,v:(185+score*7)*-dir,hue:(190+score*21)%360}}
    function key(e){if(e.code==='Space'){e.preventDefault();drop()}}
    cv.onclick=drop;window.addEventListener('keydown',key);
    function rr(x,y,w,h,r,fill){ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fillStyle=fill;ctx.fill()}
    function update(dt){if(over)return;cur.x+=cur.v*dt*Math.min(1.35,speedFactor());if(cur.x<0){cur.x=0;cur.v=Math.abs(cur.v)}if(cur.x+cur.w>460){cur.x=460-cur.w;cur.v=-Math.abs(cur.v)}flash=Math.max(0,flash-dt*2.8)}
    function draw(){const bg=ctx.createLinearGradient(0,0,0,620);bg.addColorStop(0,'#101a3a');bg.addColorStop(.55,'#111827');bg.addColorStop(1,'#07101d');ctx.fillStyle=bg;ctx.fillRect(0,0,460,620);ctx.fillStyle='rgba(255,255,255,.06)';for(let i=0;i<16;i++){const x=(i*37)%460,y=70+(i%5)*45;ctx.fillRect(x,y,18,2)}ctx.fillStyle='rgba(15,23,42,.7)';for(let i=0;i<10;i++){const w=28+(i%3)*12,h=55+(i%4)*20;ctx.fillRect(i*50,620-h,w,h)}for(const b of blocks){const grad=ctx.createLinearGradient(b.x,b.y,b.x+b.w,b.y);grad.addColorStop(0,`hsl(${b.hue} 78% 55%)`);grad.addColorStop(1,`hsl(${(b.hue+45)%360} 85% 63%)`);ctx.shadowColor=`hsla(${b.hue},90%,60%,.45)`;ctx.shadowBlur=14;rr(b.x,b.y,b.w,b.h-3,7,grad);ctx.shadowBlur=0;ctx.fillStyle='rgba(255,255,255,.16)';rr(b.x+6,b.y+5,Math.max(0,b.w-12),4,2,'rgba(255,255,255,.16)')}if(!over){const grad=ctx.createLinearGradient(cur.x,cur.y,cur.x+cur.w,cur.y);grad.addColorStop(0,'#67e8f9');grad.addColorStop(1,'#22d3ee');ctx.shadowColor='#22d3ee';ctx.shadowBlur=20;rr(cur.x,cur.y,cur.w,cur.h-3,7,grad);ctx.shadowBlur=0}if(flash>0){ctx.fillStyle=`rgba(255,255,255,${flash*.14})`;ctx.fillRect(0,0,460,620)}if(over){ctx.fillStyle='rgba(2,6,23,.72)';ctx.fillRect(0,0,460,620);ctx.fillStyle='white';ctx.font='900 34px system-ui';ctx.textAlign='center';ctx.fillText('TOWER DOWN',230,290);ctx.font='600 18px system-ui';ctx.fillStyle='#a5f3fc';ctx.fillText(`${score} tầng • ${perfect} perfect`,230,326)}}
    function frame(now){const dt=Math.min(.032,(now-last)/1000||.016);last=now;update(dt);draw();if(!over)raf=requestAnimationFrame(frame)}
    raf=requestAnimationFrame(frame);cleanup=()=>{cancelAnimationFrame(raf);window.removeEventListener('keydown',key)};draw();
  });
